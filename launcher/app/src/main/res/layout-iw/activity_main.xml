<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only header positioning. Other languages use layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden).
         Keep in step with layout/activity_main.xml: every view there must exist here too. -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- The focused card's picture, full bleed, with its scrim drawn in (MainActivity.compose); two layers
         crossfade. -->
    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/backdropA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:alpha="0"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/backdropB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:alpha="0"
            android:contentDescription="@null" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="27dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/clockBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_regular"
                android:includeFontPadding="false" />

            <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
            <TextView
                android:id="@+id/shamsiDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@string/font_regular"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSettings"
            style="@style/HeaderIcon"
            android:contentDescription="@string/settings"
            android:drawableStart="@drawable/ic_settings" />

        <TextView
            android:id="@+id/btnBell"
            style="@style/HeaderIcon"
            android:contentDescription="@string/notifications"
            android:drawableStart="@drawable/ic_bell" />

        <TextView
            android:id="@+id/btnSearch"
            style="@style/HeaderIcon"
            android:contentDescription="@string/search"
            android:drawableStart="@drawable/ic_search" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/HeaderIcon"
            android:maxWidth="260dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:contentDescription="@string/wifi"
            android:drawableStart="@drawable/ic_wifi" />

        <TextView
            android:id="@+id/btnInputs"
            style="@style/HeaderIcon"
            android:contentDescription="@string/inputs"
            android:drawableStart="@drawable/ic_input" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:background="@drawable/tabs_bg">

            <TextView
                android:id="@+id/tabTv"
                style="@style/HeaderTab"
                android:text="@string/tab_tv" />

            <TextView
                android:id="@+id/tabGames"
                style="@style/HeaderTab"
                android:text="@string/tab_games" />

            <TextView
                android:id="@+id/tabApps"
                style="@style/HeaderTab"
                android:text="@string/tab_apps" />

            <TextView
                android:id="@+id/tabHome"
                style="@style/HeaderTab"
                android:text="@string/tab_home" />
        </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp">

            <com.gathin.tvhome.RowsScrollView
                android:id="@+id/homeRows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/rowsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="48dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

            <!-- The focused card, large: its backdrop fills the screen behind this text. The lines around the
                 title have fixed sizes, so only a title of another line count changes the layout. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:clipChildren="false">

            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="@dimen/hero_text_width"
                    android:layout_height="24dp"
                    android:layout_gravity="right"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/heroApp"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical|right"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="#D9FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@string/font_medium" />

                    <ImageView
                        android:id="@+id/heroBadge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="@dimen/hero_text_width"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="bottom|right"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp"
                    android:fontFamily="@string/font_medium"
                    android:lineSpacingMultiplier="0.95"
                    android:shadowColor="#80000000"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:layout_width="@dimen/hero_text_width"
                    android:layout_height="24dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|right"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@string/font_regular" />
            </LinearLayout>

            <include
                layout="@layout/home_now_playing"
                android:layout_width="@dimen/now_playing_width"
                android:layout_height="152dp"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="48dp"
                android:layout_marginBottom="8dp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/sectionWatching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/titleWatching"
                    style="@style/RowTitle"
                    android:text="@string/row_watching" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rowWatching"
                    style="@style/Row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/titleRecent"
                    style="@style/RowTitle"
                    android:text="@string/row_recent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rowRecent"
                    style="@style/Row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/titleGames"
                    style="@style/RowTitle"
                    android:text="@string/row_games" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rowGames"
                    style="@style/Row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/titleTv"
                    style="@style/RowTitle"
                    android:text="@string/row_tv" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rowTv"
                    style="@style/Row" />
            </LinearLayout>

                </LinearLayout>
            </com.gathin.tvhome.RowsScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsGrid"
                style="@style/TabGrid" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gamesGrid"
                style="@style/TabGrid" />

            <include layout="@layout/home_tv_tab" />

            <!-- The Games tab before there are games: find the PC, pair with it, wait for its list. -->
            <LinearLayout
                android:id="@+id/gamesSetup"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/glass_panel"
                android:visibility="gone">

                <TextView
                    android:id="@+id/gamesSetupTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:id="@+id/gamesSetupPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="56sp"
                    android:fontFamily="@string/font_medium"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gamesSetupBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="right"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@string/font_regular" />

                <LinearLayout
                    android:id="@+id/gamesSetupRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Shown only when show_stats is on. -->
    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="48dp"
        android:layout_marginBottom="27dp"
        android:singleLine="true"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@string/font_medium"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
