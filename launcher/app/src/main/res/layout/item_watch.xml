<?xml version="1.0" encoding="utf-8"?>
<!-- A Continue watching card: artwork (or the app's banner), the app's icon as a badge, title and subtitle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="240dp"
        android:layout_height="135dp"
        android:background="@drawable/tile_bg"
        android:foreground="@drawable/card_focus"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/badge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:padding="4dp"
            android:background="@drawable/badge_bg"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- How far into the show: a thin bar along the bottom edge, only when the app reports it. -->
        <FrameLayout
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="#59FFFFFF"
            android:visibility="gone">

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#FFFFFFFF" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@string/font_regular" />
</LinearLayout>
