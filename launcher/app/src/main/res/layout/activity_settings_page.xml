<?xml version="1.0" encoding="utf-8"?>
<!-- A page of the launcher's own Settings: title, hint, an optional big line (the pairing PIN) and the rows on the
     Inputs dropdown's glass panel. SettingsActivity fills it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/pageHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFACB8C1"
            android:textSize="15sp"
            android:textAlignment="viewStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pageBig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="96sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.2"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pageRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/glass_panel"
            android:padding="6dp" />
    </LinearLayout>
</ScrollView>
