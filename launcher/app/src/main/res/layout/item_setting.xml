<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a Settings page: the Inputs dropdown's row, taller, with a summary line and a value at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <View
        android:id="@+id/swatch"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="17sp"
            android:fontFamily="@string/font_medium"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@drawable/pill_text_mid"
            android:duplicateParentState="true"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular"
            android:textAlignment="viewStart"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@drawable/pill_text_mid"
        android:duplicateParentState="true"
        android:textSize="14sp"
        android:fontFamily="@string/font_medium"
        android:visibility="gone" />
</LinearLayout>
